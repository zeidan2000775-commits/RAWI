# ======================================================================
#  روي (RAWI) — Environment Variables
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تُضِف .env إلى Git.
#  Copy this file to .env and fill in real values. NEVER commit .env.
# ======================================================================

# ---- Firebase Web (public — يُشحن مع العميل، محمي بـ Security Rules + App Check) ----
FIREBASE_API_KEY=AIzaSy_your_web_api_key
FIREBASE_AUTH_DOMAIN=rawi-bc58f.firebaseapp.com
FIREBASE_PROJECT_ID=rawi-bc58f
FIREBASE_STORAGE_BUCKET=rawi-bc58f.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=563628996043
FIREBASE_APP_ID=1:563628996043:web:xxxxxxxxxxxxxxxx

# App Check (reCAPTCHA v3 site key — public)
FIREBASE_APPCHECK_SITE_KEY=

# ---- Firebase Admin SDK (SECRET — backend only) ----
# الصق محتوى ملف service account كسطر JSON واحد (private_key مع \n)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"rawi-bc58f", "...":"..."}

# ---- Gemini AI (SECRET — backend only) ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ---- Telegram Bots (SECRET — backend only) ----
# 6 بوتات مُختارة. الأدوار: الراوي، الحارس، الوراق، الناقد، الخازن، الخبير
TELEGRAM_ADMIN_CHAT_ID=8497270318

BOT_RAWI_TOKEN=          # الراوي  — مولّد المحتوى (Narrator)
BOT_HARIS_TOKEN=         # الحارس  — الإشراف والبلاغات (Guardian)
BOT_WARRAQ_TOKEN=        # الوراق  — الموسوعة والأرشفة (Scribe)
BOT_NAQID_TOKEN=         # الناقد  — تقييم الجودة (Critic)
BOT_KHAZIN_TOKEN=        # الخازن  — المسابقات والأوسمة (Treasurer)
BOT_KHABIR_TOKEN=        # الخبير  — التحليلات والاتجاهات (Analyst)

# Webhook base (Render/Vercel public URL) — leave blank to use long-polling
PUBLIC_WEBHOOK_BASE=
WEBHOOK_SECRET=change_me_to_a_long_random_string

# ---- Runtime ----
NODE_ENV=development
PORT=8080
# مفتاح التشغيل الطارئ (Read-Only Kill Switch)
KILL_SWITCH=false
# علم التحقيق من الدخل (Feature Flag) — التحكم من بوت الخازن
MONETIZATION_ENABLED=false
