# ======================================================================
#  روي (RAWI) — متغيّرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم. لا تُضِف .env إلى Git.
#  للنشر: أضِف نفس القيم في Vercel / GitHub Actions Secrets.
# ======================================================================

# ---- Firebase Web (عام — يُشحن مع العميل، محمي بـ Security Rules) ----
# هذه القيم موجودة أصلًا في public/config.js (لا حاجة لتكرارها للنشر).
FIREBASE_API_KEY=AIzaSy_your_web_api_key
FIREBASE_PROJECT_ID=rawi-bc58f

# ---- Firebase Admin (سرّي — للمولّد فقط: scripts/ai-generate.js) ----
# الصق محتوى ملف service account كسطر JSON واحد (private_key مع \n).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"rawi-bc58f","...":"..."}

# ---- Gemini AI (سرّي — للمولّد فقط) ----
# بدون مفتاح، يستخدم المولّد معجمًا تراثيًا مختارًا (لا يفشل).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
