rules_version = '2';
// ======================================================================
//  روي (RAWI) — Firestore Security Rules (مبسّطة)
//  - القراءة عامة للمحتوى المنشور.
//  - المولّد (Admin SDK) يكتب المحتوى ويتجاوز هذه القواعد.
//  - العميل: كتابة محدودة (نشر/إعجاب/تعليق) تتطلب تسجيل دخول.
//  - Kill Switch عام عبر config/system.readOnly.
// ======================================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function writable() {
      return !exists(/databases/$(db)/documents/config/system) ||
             get(/databases/$(db)/documents/config/system).data.readOnly != true;
    }
    function onlyCounts() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts','updatedAt']);
    }

    // إعدادات عامة — قراءة للجميع، الكتابة للمولّد (Admin) فقط
    match /config/{doc} { allow read: if true; allow write: if false; }

    // حجز أسماء المستخدمين الفريدة
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && writable() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // المستخدمون
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && writable();
      allow update: if isOwner(uid) && writable()
        && request.resource.data.role == resource.data.role
        && request.resource.data.badges == resource.data.badges
        && request.resource.data.isVerified == resource.data.isVerified;
      allow delete: if false;
      match /bookmarks/{postId} { allow read, write: if isOwner(uid) && writable(); }
      match /following/{t}      { allow read: if true; allow write: if isOwner(uid) && writable(); }
    }

    // المنشورات (يولّدها الذكاء الاصطناعي أو ينشرها المستخدم)
    match /posts/{postId} {
      allow read: if resource.data.status == 'published'
                  || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && writable()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 600
        && request.resource.data.createdAt == request.time;
      // المالك يعدّل محتواه، وأي مسجّل يعدّل العدّادات فقط
      allow update: if writable() && ( isOwner(resource.data.authorId) || (signedIn() && onlyCounts()) );
      allow delete: if false;

      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && writable()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body.size() <= 500;
        allow update, delete: if isOwner(resource.data.authorId);
      }
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isOwner(uid) && writable();
      }
    }

    // القصص اليومية
    match /stories/{sid} {
      allow read: if true;
      allow create: if signedIn() && writable() && request.resource.data.authorId == request.auth.uid;
      allow update: if writable() && signedIn() && onlyCounts();
      allow delete: if isOwner(resource.data.authorId);
    }

    // الموسوعة (يكتبها المولّد فقط)
    match /encyclopedia/{eid} { allow read: if true; allow write: if false; }

    // الإشعارات (لصاحبها)
    match /notifications/{uid}/items/{nid} { allow read, write: if isOwner(uid); }
  }
}
